# --- AI brain: an OpenAI key OR a local OpenAI-compatible server ---
OPENAI_API_KEY=sk-...
TARS_LLM_BASE_URL=        # e.g. http://localhost:11434/v1 for Ollama (key optional)

# --- Optional: better voice (the closest to the movie) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TARS_PIPER_VOICE=         # path to a Piper .onnx voice for free local neural TTS

# --- Behaviour ---
TARS_MODEL=gpt-4o-mini
TARS_LANGUAGE=en          # en | it | es | fr | de | pt | ja
TARS_WAKE_WORD=tars
TARS_ACK=auto             # spoken after the wake word: auto | off | custom text
TARS_FOLLOWUP_WINDOW=6    # seconds to keep listening after a reply (0 = off)
TARS_TTS=auto             # elevenlabs | openai | espeak | auto
TARS_STT=auto             # openai | vosk | auto

# --- Hardware ---
TARS_SIM=0                # 1 = no servo hardware (development mode)
TARS_GAMEPAD=/dev/input/event3   # autodetected if this path is wrong
TARS_WEB_PORT=8000
TARS_WEB_PASSWORD=        # set to require login on the dashboard
TARS_TLS=0                # 1 = self-signed HTTPS (browser mic works on LAN; pip install pyopenssl)

# --- Optional integrations ---
HA_URL=                   # e.g. http://homeassistant.local:8123
HA_TOKEN=                 # Home Assistant long-lived access token
TARS_MUSIC_DIR=           # local music folder (default: data/music)
TARS_CAMERA_URL=          # network camera (rtsp://... or http://phone:8080/video)
DISCORD_WEBHOOK=          # TARS posts falls/low-battery/messages there (discord_send skill)
